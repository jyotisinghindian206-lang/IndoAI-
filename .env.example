# Copy values into Render Environment settings; never commit real secrets.
# AI providers
GEMINI_API_KEY=
GEMINI_API_KEYS=
INDO_OPENAI_API_KEY=
INDO_OLLAMA_API_KEY=
INDO_PROVIDERS=gemini,openai,ollama
INDO_PRIMARY_PROVIDER=gemini
INDO_OLLAMA_ENABLED=1
INDO_OLLAMA_MODE=cloud

# Persistent data (on Render, attach a persistent disk mounted at /var/data)
INDO_DATA_DIR=/var/data
INDO_SESSION_SECRET=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional voice, media, GIF, image and news integrations
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GIPHY_API_KEY=
NEWSAPI_API_KEY=
POLLINATIONS_API_KEY=
